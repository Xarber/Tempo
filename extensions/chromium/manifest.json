{
  "manifest_version": 3,
  "name": "Tempo Focus Companion",
  "version": "0.1.0",
  "description": "Optional, local-only website reminders during your configured Tempo focus session.",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Tempo Focus"},
  "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "style.css"], "matches": ["http://*/*", "https://*/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
